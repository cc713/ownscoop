{
    "version": "2.0.0",
    "description": "Comic and Manga reader, written with Node.js and using Electron",
    "homepage": "https://github.com/ollm/OpenComic",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/ollm/OpenComic/releases/download/v2.0.0/OpenComic.Setup.2.0.0.exe#dl.7z",
            "hash": "1ffe1f0a321e383a9491afc5ab9969f6aa89ac3fbecf946e2b26d9dfe8bf225b"
        }
    },
    "extract_dir": "$PLUGINSDIR",
    "installer": {
        "script": [
            "Remove-Item \"$dir\\*\" -Exclude 'app-64.7z'",
            "Expand-7zipArchive \"$dir\\app-64.7z\" \"$dir\" -Removal"
        ]
    },
    "bin": "OpenComic.exe",
    "shortcuts": [
        [
            "OpenComic.exe",
            "OpenComic"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/ollm/OpenComic/releases/download/v$version/OpenComic.Setup.$version.exe#dl.7z"
    }
}
